{
  "name": "melodia",
  "version": "1.0.0",
  "private": true,
  "description": "Reproductor de musica offline instalable (PWA). Sin internet, sin anuncios, con tus playlists.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "icons": "node tools/make-icons.mjs",
    "check": "node tools/check.mjs",
    "test:tags": "node tools/test-tags.mjs",
    "test:server": "node tools/test-server.mjs",
    "test:browser": "node tools/test-browser.mjs",
    "test": "node tools/check.mjs && node tools/test-tags.mjs && node tools/test-server.mjs && node tools/test-browser.mjs"
